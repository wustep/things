{
  "name": "things",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Things: a shelf of my favorite things.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "ingest": "tsx scripts/ingest.ts",
    "software": "tsx scripts/software.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && node --import tsx --test --test-concurrency=1 tests/e2e/*.test.ts",
    "refine": "tsx scripts/refine.ts",
    "images": "npm --prefix tools/images install --no-audit --no-fund --silent && tsx tools/images/build.ts && tsx tools/images/share.ts",
    "og": "npm --prefix tools/images install --no-audit --no-fund --silent && tsx tools/images/home-card.ts"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/spectral": "^5.2.8",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@jimp/core": "^1.6.1",
    "@jimp/types": "^1.6.1",
    "@jsquash/avif": "^1.3.0",
    "@jsquash/webp": "^1.5.0",
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "cheerio": "^1.0.0",
    "jimp": "^1.6.0",
    "playwright": "^1.64.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^8.3.5"
  }
}
